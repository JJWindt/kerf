{
  "sourceLanguage": "en",
  "strings": {
    "CFBundleDisplayName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kerf"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kerf"
          }
        }
      }
    },
    "NSAppleEventsUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kerf controls music apps and reads render progress from DaVinci Resolve."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kerf bedient muziek-apps en leest de rendervoortgang uit DaVinci Resolve."
          }
        }
      }
    },
    "NSAudioCaptureUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kerf moves the waveform in the notch with the music. It only measures loudness; nothing is recorded."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kerf laat het golfje in de notch meebewegen met de muziek. Het meet alleen hoe hard; er wordt niets opgenomen."
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kerf shows your AirPods and their battery when they connect."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kerf toont je AirPods en hun batterij als ze verbinden."
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kerf shows your next event and its join link in the notch."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kerf toont je volgende afspraak en de link om deel te nemen in de notch."
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kerf shows your camera as a mirror in the notch."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kerf toont je camera als spiegel in de notch."
          }
        }
      }
    },
    "NSDownloadsFolderUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kerf shows the progress of your downloads in the notch."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kerf toont de voortgang van je downloads in de notch."
          }
        }
      }
    },
    "NSHumanReadableCopyright": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "© 2026 Paul Boerma"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "© 2026 Paul Boerma"
          }
        }
      }
    },
    "NSLocationUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kerf shows the weather where you are."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kerf toont het weer waar je bent."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kerf turns what you say into a question for Claude."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kerf maakt van wat je zegt een vraag voor Claude."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kerf turns what you say into a question for Claude."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kerf maakt van wat je zegt een vraag voor Claude."
          }
        }
      }
    }
  },
  "version": "1.0"
}